# Copy to .github/workflows/azure-static-web-apps.yml if deploying through GitHub Actions.
# Azure normally generates this workflow and stores the deployment token as a repository secret.
name: Deploy Azure Static Web App
on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, closed]
    branches: [main]
jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
      - uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          action: ${{ github.event.action == 'closed' && 'close' || 'upload' }}
          app_location: /
          output_location: ''
          skip_app_build: true
